// LeiOS Fastfetch system configuration
// Installed to /usr/share/fastfetch/config.jsonc so fastfetch falls back to
// this file when the user has no personal config in ~/.config/fastfetch/.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "file",
        "source": "/usr/share/fastfetch/logos/leios.txt",
        "padding": {
            "top": 1,
            "left": 2
        }
    },

    "display": {
        "separator": "  ",
        "color": {
            "title": "cyan",
            "keys": "blue",
            "output": "default"
        }
    },

    "modules": [
        "title",
        "separator",
        "os",
        "host",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "display",
        "de",
        "wm",
        "wmtheme",
        "theme",
        "icons",
        "font",
        "cursor",
        "terminal",
        "terminalfont",
        "cpu",
        "gpu",
        "memory",
        "swap",
        "disk",
        "localip",
        "battery",
        "poweradapter",
        "locale",
        "break",
        "colors"
    ]
}
