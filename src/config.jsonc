// LeiOS Fastfetch default configuration
// Installed to /etc/fastfetch/config.jsonc, the last place fastfetch looks for
// a config (see fastfetch --list-config-paths). It is only used while no
// config exists in ~/.config/fastfetch/ or /etc/xdg/fastfetch/.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "file",
        "source": "/usr/share/fastfetch/logos/leios.txt",
        "padding": {
            "top": 1,
            "left": 2
        }
    },

    "display": {
        "separator": "  ",
        "color": {
            "title": "cyan",
            "keys": "blue",
            "output": "default"
        }
    },

    "modules": [
        "title",
        "separator",
        "os",
        "host",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "display",
        "de",
        "wm",
        "wmtheme",
        "theme",
        "icons",
        "font",
        "cursor",
        "terminal",
        "terminalfont",
        "cpu",
        "gpu",
        "memory",
        "swap",
        "disk",
        "localip",
        "battery",
        "poweradapter",
        "locale",
        "break",
        "colors"
    ]
}
