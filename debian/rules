#!/usr/bin/make -f

export DH_VERBOSE = 1

%:
	dh $@

# Use only the safe 'clean' target during debhelper's clean phase.
# 'distclean' would also remove the build output directory that we need
# to keep while the package is being assembled.
override_dh_auto_clean:
	$(MAKE) clean

override_dh_auto_test:
	# Fastfetch cannot run during package build

override_dh_auto_install:
	rm -rf debian/leios.theme.fastfetch-theme/usr/share/fastfetch
	mkdir -p debian/leios.theme.fastfetch-theme/usr/share/fastfetch/logos
	cp -a src/logos/* debian/leios.theme.fastfetch-theme/usr/share/fastfetch/logos/
	# Lowest-priority config location; user and /etc/xdg configs override it.
	install -D -m 0644 src/config.jsonc debian/leios.theme.fastfetch-theme/etc/fastfetch/config.jsonc

override_dh_auto_build:
